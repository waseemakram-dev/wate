# ============================================================
# ⚡ WATE Killer App: Nexus Cloud Enterprise REST & Real-Time API
# ============================================================
# Built entirely in WATE native syntax demonstrating:
#  - Native HTTP REST Server & Dynamic Route Dispatcher
#  - Real-Time WebSockets Server & Event Broadcasting (ws)
#  - Cryptographic Password Hashing (crypto.bcrypt)
#  - Data Encryption / Decryption (crypto.aes)
#  - JWT Token Authentication & Verification (jwt)
#  - Fluent Object Relational Mapper & Active Record (orm)
#  - Schema Environment Configuration (env)
#  - Structured Logging Utility (logger)
# ============================================================

# 1. Environment Schema Configuration
set rawEnv = "APP_NAME=NexusCloud\nPORT=8085\nWS_PORT=8086\nJWT_SECRET=nexus-enterprise-secret-key-2026\nLOG_LEVEL=info\n"
set envValidator = env.schema({
    APP_NAME: { type: "string", default: "NexusAPI" },
    PORT: { type: "number", default: 8085 },
    WS_PORT: { type: "number", default: 8086 },
    JWT_SECRET: { type: "string", required: true },
    LOG_LEVEL: { type: "string", default: "info" }
})
set config = envValidator.validate(env.parse(rawEnv))

# 2. Structured Logger
logger.setLevel(config.LOG_LEVEL)
set appLog = logger.create({ tag: "NexusCore" })
set auditLog = logger.create({ tag: "AuditSecurity" })

appLog.info(f"Initializing {config.APP_NAME} Enterprise Microservice...")

# 3. Native ORM Data Models
set User = orm.define("User", {}, { tableName: "nexus_users" })
set Project = orm.define("Project", {}, { tableName: "nexus_projects" })
set Incident = orm.define("Incident", {}, { tableName: "nexus_incidents" })

User.clear()
Project.clear()
Incident.clear()

# Seed default administrator account with bcrypt hashed password
set adminPasswordHash = crypto.bcrypt.hash("AdminSecure2026!", 8)
User.create({
    username: "nexus_admin",
    passwordHash: adminPasswordHash,
    role: "admin",
    email: "admin@nexuscloud.internal",
    createdAt: "2026-09-18T00:00:00Z"
})
appLog.info("Default administrator account provisioned (bcrypt hashed).")

# Seed initial projects
Project.create({
    name: "Quantum Engine",
    description: "High performance parallel register execution engine",
    owner: "nexus_admin",
    stars: 142,
    status: "active"
})
Project.create({
    name: "Titan DB",
    description: "Distributed storage layer with ACID compliance",
    owner: "nexus_admin",
    stars: 88,
    status: "active"
})

# 4. Native WebSockets Real-Time Server
set wsServer = ws.createServer(config.WS_PORT)
appLog.info(f"WebSocket telemetry server online on ws://localhost:{config.WS_PORT}")

fn broadcastRealtimeEvent(eventType, payload) {
    set eventData = json.stringify({
        event: eventType,
        timestamp: "2026-09-18T10:00:00Z",
        data: payload
    })
    wsServer.broadcast(eventData)
}

# 5. Helper Utilities for HTTP Handlers
fn sendJson(res, statusCode, data) {
    res.writeHead(statusCode, {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Headers": "Authorization, Content-Type"
    })
    res.end(json.stringify(data))
}

fn extractAuthUser(req) {
    set authHeader = req.headers["authorization"]
    if (!authHeader || !authHeader.startsWith("Bearer ")) {
        return null
    }
    set token = authHeader.slice(7)
    try {
        set claims = jwt.verify(token, config.JWT_SECRET)
        return claims
    } catch (e) {
        return null
    }
}

# 6. Native HTTP Server & REST Router
set server = http.createServer(fn(req, res) {
    set body = ""
    req.on("data", fn(chunk) {
        body = body + chunk
    })

    req.on("end", fn() {
        set url = req.url
        set reqMethod = req.method

        # Handle CORS Preflight
        if (reqMethod is "OPTIONS") {
            res.writeHead(204, {
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
                "Access-Control-Allow-Headers": "Authorization, Content-Type"
            })
            res.end()
            return null
        }

        # Parse JSON body if present
        set jsonBody = {}
        if (body.length > 0) {
            try {
                jsonBody = json.parse(body)
            } catch (e) {
                # Non-JSON payload
            }
        }

        # ----------------------------------------------------
        # Route 1: System Health & Info (GET / or GET /health)
        # ----------------------------------------------------
        if (url is "/" || url is "/health") {
            sendJson(res, 200, {
                status: "healthy",
                engine: "WATE Enterprise Engine v10.0.0",
                name: config.APP_NAME,
                port: config.PORT,
                wsPort: config.WS_PORT,
                features: ["REST", "WebSockets", "ORM", "JWT", "AES-256", "bcrypt"],
                stats: {
                    totalUsers: User.count(),
                    totalProjects: Project.count(),
                    totalIncidents: Incident.count()
                }
            })
            return null
        }

        # ----------------------------------------------------
        # Route 2: User Registration (POST /api/auth/register)
        # ----------------------------------------------------
        if (url is "/api/auth/register" && reqMethod is "POST") {
            if (!jsonBody.username || !jsonBody.password) {
                sendJson(res, 400, { error: "Username and password required." })
                return null
            }
            
            set existing = User.findOne({ username: jsonBody.username })
            if (existing) {
                sendJson(res, 409, { error: "User already exists." })
                return null
            }

            set hashedPwd = crypto.bcrypt.hash(jsonBody.password, 8)
            set newUser = User.create({
                username: jsonBody.username,
                passwordHash: hashedPwd,
                role: jsonBody.role || "developer",
                email: jsonBody.email || (jsonBody.username + "@nexus.internal"),
                createdAt: "2026-09-18T10:00:00Z"
            })

            auditLog.info(f"New user registered: {newUser.username} ({newUser.role})")
            broadcastRealtimeEvent("user_registered", { username: newUser.username, role: newUser.role })

            sendJson(res, 201, {
                message: "User registered successfully",
                user: { id: newUser.id, username: newUser.username, role: newUser.role }
            })
            return null
        }

        # ----------------------------------------------------
        # Route 3: User Login (POST /api/auth/login)
        # ----------------------------------------------------
        if (url is "/api/auth/login" && reqMethod is "POST") {
            if (!jsonBody.username || !jsonBody.password) {
                sendJson(res, 400, { error: "Username and password required." })
                return null
            }

            set user = User.findOne({ username: jsonBody.username })
            if (!user) {
                sendJson(res, 401, { error: "Invalid credentials: User not found." })
                return null
            }

            set isMatch = crypto.bcrypt.compare(jsonBody.password, user.passwordHash)
            if (!isMatch) {
                auditLog.warn(f"Failed login attempt for user: {user.username}")
                sendJson(res, 401, { error: "Invalid credentials: Password incorrect." })
                return null
            }

            # Generate Signed JWT Token
            set tokenPayload = {
                sub: user.id,
                username: user.username,
                role: user.role
            }
            set token = jwt.sign(tokenPayload, config.JWT_SECRET, { expiresIn: "8h" })
            auditLog.info(f"JWT Token issued for {user.username} (Role: {user.role})")

            sendJson(res, 200, {
                message: "Authentication successful",
                token: token,
                expiresIn: "8h",
                user: { id: user.id, username: user.username, role: user.role }
            })
            return null
        }

        # ----------------------------------------------------
        # Route 4: List Projects (GET /api/projects)
        # ----------------------------------------------------
        if (url.startsWith("/api/projects") && reqMethod is "GET") {
            set projects = Project.query().orderBy("stars", "DESC").execute()
            sendJson(res, 200, { count: projects.length, projects: projects })
            return null
        }

        # ----------------------------------------------------
        # Route 5: Create Project [PROTECTED] (POST /api/projects)
        # ----------------------------------------------------
        if (url is "/api/projects" && reqMethod is "POST") {
            set authUser = extractAuthUser(req)
            if (!authUser) {
                sendJson(res, 401, { error: "Unauthorized: Valid JWT Bearer token required." })
                return null
            }

            if (!jsonBody.name) {
                sendJson(res, 400, { error: "Project name is required." })
                return null
            }

            set newProj = Project.create({
                name: jsonBody.name,
                description: jsonBody.description || "No description",
                owner: authUser.username,
                stars: jsonBody.stars || 0,
                status: "active",
                createdAt: "2026-09-18T10:00:00Z"
            })

            appLog.info(f"Project created: '{newProj.name}' by {authUser.username}")
            broadcastRealtimeEvent("project_created", newProj)

            sendJson(res, 201, { message: "Project created", project: newProj })
            return null
        }

        # ----------------------------------------------------
        # Route 6: Incident Management [PROTECTED] (GET/POST /api/incidents)
        # ----------------------------------------------------
        if (url is "/api/incidents" && reqMethod is "GET") {
            set incidents = Incident.find({})
            sendJson(res, 200, { count: incidents.length, incidents: incidents })
            return null
        }

        if (url is "/api/incidents" && reqMethod is "POST") {
            set authUser = extractAuthUser(req)
            if (!authUser) {
                sendJson(res, 401, { error: "Unauthorized: Valid JWT Bearer token required." })
                return null
            }

            set newIncident = Incident.create({
                title: jsonBody.title || "Unspecified incident",
                severity: jsonBody.severity || "medium",
                status: "open",
                reportedBy: authUser.username,
                createdAt: "2026-09-18T10:00:00Z"
            })

            auditLog.warn(f"Security/Ops incident reported: {newIncident.title} [{newIncident.severity}]")
            broadcastRealtimeEvent("incident_reported", newIncident)

            sendJson(res, 201, { message: "Incident logged", incident: newIncident })
            return null
        }

        # ----------------------------------------------------
        # Route 7: System Statistics (GET /api/stats)
        # ----------------------------------------------------
        if (url is "/api/stats" && reqMethod is "GET") {
            sendJson(res, 200, {
                users: User.count(),
                projects: Project.count(),
                incidents: Incident.count(),
                uptimeSeconds: 120,
                architecture: "Register VM + JIT Compiler + Native Microservice"
            })
            return null
        }

        # Default 404
        sendJson(res, 404, { error: "Route not found", path: url, method: reqMethod })
    })
})

server.listen(config.PORT, fn() {
    out("================================================================")
    out(f"🚀 Nexus Cloud API is online on http://localhost:{config.PORT}")
    out(f"⚡ Real-Time WebSocket server on ws://localhost:{config.WS_PORT}")
    out("================================================================")
})

# Export server and wsServer for programmatic testing
set exportModule = {
    server: server,
    wsServer: wsServer,
    config: config,
    models: { User: User, Project: Project, Incident: Incident }
}
set module.exports = exportModule

