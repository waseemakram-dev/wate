{
  "name": "wate-lang",
  "displayName": "WATE Language Support",
  "description": "Syntax highlighting, snippets, and language support for WATE",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "publisher": "WazemTech",
  "contributes": {
    "breakpoints": [
      {
        "language": "wate"
      }
    ],
    "debuggers": [
      {
        "type": "wate",
        "label": "WATE Debugger",
        "program": "./wate-debug-adapter.js",
        "runtime": "node",
        "languages": ["wate"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .wate file to debug",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "wate",
            "name": "Debug WATE File",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "wate",
        "aliases": ["WATE", "wate"],
        "extensions": [".wate"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/wate-icon.svg",
          "dark": "./icons/wate-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "wate",
        "scopeName": "source.wate",
        "path": "./syntaxes/wate.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "wate",
        "path": "./snippets/wate.code-snippets"
      }
    ]
  }
}
