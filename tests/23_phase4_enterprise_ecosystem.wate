pdfDoc.text("WATE Enterprise Systems Audit Report", 50, 750, { size: 16 })
pdfDoc.line(50, 740, 545, 740, { width: 1.5 })
pdfDoc.rect(50, 620, 495, 100)
pdfDoc.table(
    ["Module", "Version", "Compliance", "Status"],
    [
        ["WebSockets", "RFC-6455", "100%", "PASSED"],
        ["JWT Auth", "RFC-7519", "100%", "PASSED"],
        ["Crypto / AES", "FIPS-197", "100%", "PASSED"],
        ["Fluent ORM", "v1.0", "100%", "PASSED"]
    ],
    { x: 55, y: 700, colWidth: 120, rowHeight: 18 }
)
pdfDoc.addPage()
pdfDoc.text("Appendix A: Standard Library Capabilities", 50, 750, { size: 14 })
