# ------------------------------------------------------------
# 48. Localization (i18n)
# ------------------------------------------------------------
out("\n12. Testing Localization (i18n)...")
i18n.load("en", {
    welcome: "Welcome back, {user}!",
    cart: {
        zero: "Your cart is empty",
        one: "You have 1 item in your cart",
        other: "You have {count} items in your cart"
    },
    menu: {
        dashboard: "Dashboard",
        settings: "Settings",
        logout: "Log Out"
    }
})

i18n.load("ur", {
    welcome: "Khushamdeed, {user}!",
    cart: {
        zero: "Aap ki tokri khali hai",
        one: "Aap ki tokri mein 1 item hai",
        other: "Aap ki tokri mein {count} items hain"
    },
    menu: {
        dashboard: "Dashboard",
        logout: "Bahir niklein"
    }
})

# Urdu translations & interpolation
i18n.setLocale("ur")
assert.equal(i18n.t("welcome", { user: "Waseem" }), "Khushamdeed, Waseem!", "Urdu parameterized translation mismatch")
assert.equal(i18n.t("cart", { count: 0 }), "Aap ki tokri khali hai", "Urdu plural zero mismatch")
assert.equal(i18n.t("cart", { count: 1 }), "Aap ki tokri mein 1 item hai", "Urdu plural one mismatch")
assert.equal(i18n.t("cart", { count: 7 }), "Aap ki tokri mein 7 items hain", "Urdu plural other mismatch")

# English translations
i18n.setLocale("en")
assert.equal(i18n.t("welcome", { user: "Admin" }), "Welcome back, Admin!", "English parameterized translation mismatch")
assert.equal(i18n.t("cart", { count: 4 }), "You have 4 items in your cart", "English plural other mismatch")

# Fallback locale check
i18n.setLocale("ur")
i18n.setFallbackLocale("en")
# 'menu.settings' is present in 'en' but absent in 'ur'
assert.equal(i18n.t("menu.settings"), "Settings", "i18n fallback to default locale failed")

# Clean up temporary test files
sys.exec("node -e \"const fs = require('fs'); ['tests/tmp_enterprise_sample.png', 'tests/tmp_enterprise_processed.png', 'tests/tmp_enterprise_report.pdf'].forEach(f => { if (fs.existsSync(f)) try { fs.unlinkSync(f); } catch (e) {} });\"")

out("   ✓ Localization (i18n) verified successfully!")

out("\n================================================================")
out("🏆 All 12 Phase 4 Enterprise Ecosystem Features PASSED!")
out("================================================================")
