# 44. Logger Utility: Structured & Multi-Level
# ------------------------------------------------------------
out("\n8. Testing Structured Logger Utility...")
logger.setLevel("debug")
logger.setFormat("pretty")
logger.debug("Test debug message")
logger.info("Test info message")
logger.warn("Test warn message")

logger.setFormat("json")
logger.info("JSON structured log", { transactionId: "TX-100", status: "SUCCESS" })
logger.setFormat("pretty")

set appLogger = logger.create({ tag: "PaymentGateway" })
assert.ok(type.isFn(appLogger.info), "Custom scoped logger must provide info method")
assert.ok(type.isFn(appLogger.error), "Custom scoped logger must provide error method")
appLogger.info("Payment processed successfully")
out("   ✓ Structured Logger Utility verified successfully!")

# ------------------------------------------------------------
# 45. XML / YAML Parsers & Serializers
# ------------------------------------------------------------
out("\n9. Testing XML & YAML Parsers...")
# XML
set rawXml = "<service name=\"auth-service\"><port>8080</port><enabled>true</enabled></service>"
set parsedXml = xml.parse(rawXml)
assert.equal(parsedXml.tag, "service", "XML root tag mismatch")
assert.equal(parsedXml.attributes.name, "auth-service", "XML attribute name mismatch")
assert.equal(parsedXml.children.length, 2, "XML children count mismatch")

set xmlString = xml.stringify({ host: "127.0.0.1", port: 5432 }, "database")
assert.ok(xmlString.includes("<database"), "Serialized XML missing root element")
assert.ok(xmlString.includes("<host>127.0.0.1</host>"), "Serialized XML missing text content")

# YAML
set rawYaml = "project:\n  title: WATE Language\n  version: 10.0\nmodules:\n  - ws\n  - jwt\n  - orm\n"
set parsedYaml = yaml.parse(rawYaml)
assert.equal(parsedYaml.project.title, "WATE Language", "YAML parsed title mismatch")
assert.equal(parsedYaml.project.version, 10, "YAML parsed numeric value mismatch")
assert.equal(parsedYaml.modules.length, 3, "YAML parsed sequence length mismatch")
assert.equal(parsedYaml.modules[0], "ws", "YAML sequence item 0 mismatch")
assert.equal(parsedYaml.modules[2], "orm", "YAML sequence item 2 mismatch")

set yamlString = yaml.stringify(parsedYaml)
assert.ok(yamlString.includes("title: WATE Language"), "YAML stringify missing key value")
out("   ✓ XML & YAML Parsers verified successfully!")

# ------------------------------------------------------------
# 46. Image Processing Pipeline
# ------------------------------------------------------------
out("\n10. Testing Image Processing Pipeline...")
set sampleImg = "tests/tmp_enterprise_sample.png"
file.write(sampleImg, "WATE_IMAGE_DATA")

set pipe = img.Pipeline(sampleImg).resize(400, 300).crop(10, 10, 200, 200).watermark("CONFIDENTIAL", { opacity: 0.5 }).filter("contrast")

set outImg = "tests/tmp_enterprise_processed.png"
set savedImg = pipe.save(outImg)
assert.isTrue(savedImg, "Image pipeline save() failed")
assert.isTrue(wpath.exists(outImg), "Processed image file not found")

set meta = img.metadata(sampleImg)
assert.equal(meta.format, "png", "Image metadata format mismatch")
assert.equal(meta.width, 800, "Image metadata width mismatch")
out("   ✓ Image Processing Pipeline verified successfully!")

